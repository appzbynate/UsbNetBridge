<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#101722" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#1A2636" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D131D" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#364E6E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131C2A" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#24364D" />
        </shape>
    </item>
</selector>
